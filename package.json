    "electron-builder": "26.15.3",
    "typescript": "^5.7.0",
    "vite": "8.1.6"
  },
  "build": {
    "appId": "com.wanjuan.lingjing",
    "productName": "StarCanvas",
    "artifactName": "StarCanvas-1.4.9-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bin/application-operation-protocol.mjs",
      "config/harness/sdk-restricted.patch.yml"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "starcanvas-cli"
      },
      {
        "from": "docs/AUTOMATION_CLI.md",
        "to": "starcanvas-cli/README.md"
      },
      {
        "from": "bin",
        "to": "wanjuan-cli"
      },
      {
        "from": "docs/AUTOMATION_CLI.md",
        "to": "wanjuan-cli/README.md"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "mac": {
      "identity": "-",
      "hardenedRuntime": true,
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "signIgnore": [
        "/Contents/Resources/starcanvas-account-keychain(?:/|$)",
        "/Contents/Resources/assistant-harness(?:/|$)",
        "/Contents/Resources/tool-runtime(?:/|$)"
      ],
      "extraResources": [{"from":"tool-runtime/deepseek-harness/darwin-${arch}","to":"assistant-harness/darwin-${arch}"}],
      "extendInfo": {
        "CFBundleShortVersionString": "1.4.9",
        "CFBundleVersion": "1.4.9"
      }
    },
    "win": {
      "extraResources": [{"from":"tool-runtime/deepseek-harness/win32-${arch}","to":"assistant-harness/win32-${arch}"}],
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StarCanvas",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
